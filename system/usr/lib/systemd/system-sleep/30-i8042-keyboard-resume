#!/bin/sh
# After suspend the Zenbook S14 (UX5406) internal keyboard stayed dead: the lock
# screen appears but the keyboard does not type (the mouse works - different bus).
# Root cause is the kernel i8042/atkbd controller not re-initializing on resume --
# NOT the kscreenlocker greeter (killing and respawning the greeter did nothing,
# because the device is dead below the compositor, at the kernel level).
# serio0 = "i8042 KBD port". Fix: on resume, rescan the i8042 KBD port -> atkbd
# reconnects. Source (SOLVED, KDE Wayland): forums.opensuse.org/t/.../130657
case "$1" in
    post)
        [ -w /sys/devices/platform/i8042/serio0/drvctl ] && \
            printf rescan > /sys/devices/platform/i8042/serio0/drvctl
        ;;
esac
