#!/bin/sh
# The anydesk backend sometimes drops the relay while the process is still alive
# (get-status != online); Restart=always cannot see this (the process lives). This
# watchdog (timer, every 2min) catches that case. GUARD: if the service started
# <90s ago (the relay may still be connecting) DO NOT touch it -- otherwise it
# would cut a normal startup short and create a restart loop.
[ "$(nmcli networking connectivity 2>/dev/null)" = "full" ] || exit 0
[ "$(systemctl is-active anydesk.service)" = "active" ] || exit 0

# how long the service has been active (wall-clock; unaffected by suspend)
enter=$(systemctl show anydesk.service -p ActiveEnterTimestamp --value 2>/dev/null)
[ -n "$enter" ] || exit 0
enter_epoch=$(date -d "$enter" +%s 2>/dev/null) || exit 0
[ $(( $(date +%s) - enter_epoch )) -lt 90 ] && exit 0   # just started, give the relay time

status=$(anydesk --get-status 2>/dev/null)
case "$status" in
    online) exit 0 ;;
    *) systemctl restart anydesk.service
       logger -t anydesk-watchdog "status='$status' >90s active, network full -> restarted anydesk.service" ;;
esac
