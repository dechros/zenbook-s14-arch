import socket, threading, urllib.request, sys, time, re
BASE="http://c1eu.cdn.playthisgame.com"   # live CDN, NOT hijacked -> resolves real
LOG="/var/log/cabal-patch-proxy.log"
logf=open(LOG,"a")
def log(m): logf.write("%s %s\n"%(time.strftime("%H:%M:%S"),m)); logf.flush()
def handle(c):
    try:
        c.settimeout(8); buf=b""
        while b"\r\n\r\n" not in buf and len(buf)<8192:
            d=c.recv(4096)
            if not d: break
            buf+=d
        lines=buf.decode('latin1','replace').split('\r\n')
        path=lines[0].split(' ')[1] if lines and ' ' in lines[0] else '/'
        path=re.sub(r'^/+','/',path)
        try:
            r=urllib.request.urlopen(BASE+path, timeout=15)
            body=r.read(); code=r.getcode(); log("OK %s -> %d (%dB)"%(path,code,len(body)))
            c.sendall(("HTTP/1.1 %d OK\r\nContent-Length: %d\r\nConnection: close\r\n\r\n"%(code,len(body))).encode()+body)
        except urllib.error.HTTPError as e:
            body=e.read(); log("HTTP %s -> %d"%(path,e.code))
            c.sendall(("HTTP/1.1 %d X\r\nContent-Length: %d\r\nConnection: close\r\n\r\n"%(e.code,len(body))).encode()+body)
        except Exception as e:
            log("FAIL %s -> %s"%(path,e)); c.sendall(b"HTTP/1.1 502 X\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
    except Exception as e: log("ERR %s"%e)
    finally:
        try: c.close()
        except: pass
s=socket.socket(); s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)
s.bind(("127.0.0.1",80)); s.listen(200); log("=== proxy start (fwd->CDN) ===")
while True:
    try: c,_=s.accept()
    except: break
    threading.Thread(target=handle,args=(c,),daemon=True).start()
