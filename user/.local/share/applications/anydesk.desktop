[Desktop Entry]
Type=Application
Name=AnyDesk
GenericName=AnyDesk
X-GNOME-FullName=AnyDesk
# dechros: HiDPI fix. On a 2880x1800 panel @ KWin scale 2, AnyDesk's GTK drawing
# area was allocated at 1440x900 (a quarter) and the remote screen was cramped in
# the top-left. GDK_SCALE=1 forces GTK to scale 1 => the full window is allocated
# and the remote fills it.
Exec=env GDK_SCALE=1 GDK_DPI_SCALE=1 GDK_BACKEND=x11 /usr/bin/anydesk %u
Icon=anydesk
Terminal=false
TryExec=anydesk
Categories=Network;GTK;
MimeType=x-scheme-handler/anydesk;
Name[de_DE]=AnyDesk
